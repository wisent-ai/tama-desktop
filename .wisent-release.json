{
  "schema_version": 1,
  "product": "tama-desktop",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "App/Info.plist",
    "pattern": "(?s)<key>CFBundleShortVersionString</key>\\s*<string>(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)</string>"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "compile",
          "argv": [
            "bash",
            "Release/stado-release.sh",
            "compile"
          ]
        }
      ],
      "build": {
        "argv": [
          "bash",
          "Release/stado-release.sh",
          "build"
        ]
      },
      "stage": {
        "release/Tama.app": "Tama.app",
        "release/Tama.zip": "Tama.zip",
        "release/Tama.zip.sparkle-signature": "Tama.zip.sparkle-signature",
        "release/appcast.xml": "appcast.xml",
        "evidence/release.json": "evidence/release.json",
        "evidence/notary.json": "evidence/notary.json",
        "evidence/DIGESTS": "evidence/DIGESTS"
      },
      "secret_env": {
        "MACOS_CERT_P12": "wisent-apple-developer-id#certificate_p12_base64",
        "MACOS_CERT_PASSWORD": "wisent-apple-developer-id#certificate_password",
        "MACOS_SIGN_IDENTITY": "wisent-apple-developer-id#sign_identity",
        "AC_API_KEY_ID": "wisent-apple-notary#key_id",
        "AC_API_ISSUER_ID": "wisent-apple-notary#issuer_id",
        "AC_API_KEY_P8": "wisent-apple-notary#private_key_p8_base64",
        "SPARKLE_PRIVATE_KEY": "tama-desktop-sparkle#private_key",
        "TAMA_APP_PROFILE_B64": "tama-desktop-signing#app_provisioning_profile_base64",
        "TAMA_NETWORK_FILTER_PROFILE_B64": "tama-desktop-signing#network_filter_provisioning_profile_base64"
      }
    }
  },
  "inputs": {
    "wisent-desktop-update": {
      "uri": "stado://sources/wisent-desktop-update/sha256/1f3c919e7e15ef6736a7c9c841ca185cb487e502c0da39be68aa1aa8b487af47/source.tar.gz",
      "sha256": "1f3c919e7e15ef6736a7c9c841ca185cb487e502c0da39be68aa1aa8b487af47",
      "mount": "wisent-desktop-update.tar.gz",
      "extract": false
    },
    "tama": {
      "uri": "stado://sources/tama/sha256/415d6b9824d6fc47a7ebdc4395ed94cb18113c2553251cad50e1f9000d5ab326/source.tar.gz",
      "sha256": "415d6b9824d6fc47a7ebdc4395ed94cb18113c2553251cad50e1f9000d5ab326",
      "mount": "tama.tar.gz",
      "extract": false
    },
    "swiftpm-cache": {
      "uri": "stado://sources/tama-swiftpm-cache/sha256/69afd7557e507caa16f64ac96a723c5daa74091bbe3417e423409634b670ada3/source.tar.gz",
      "sha256": "69afd7557e507caa16f64ac96a723c5daa74091bbe3417e423409634b670ada3",
      "mount": "swiftpm-cache.tar.gz",
      "extract": false
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "sparkle-appcast",
      "platform": "darwin-arm64",
      "argv": [
        "python3",
        "Release/deliver-sparkle.py"
      ],
      "required": true,
      "secret_env": {
        "WISENT_SPARKLE_UPLOAD_BASE_URL": "tama-desktop-sparkle#upload_base_url",
        "WISENT_SPARKLE_TOKEN": "tama-desktop-sparkle#delivery_token"
      }
    }
  ]
}
