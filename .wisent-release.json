{
  "schema_version": 1,
  "product": "tama-desktop",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "App/Info.plist",
    "pattern": "(?s)<key>CFBundleShortVersionString</key>\\s*<string>(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)</string>"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "bash",
            "release/fmt.sh",
            "--check"
          ],
          "kind": "format"
        },
        {
          "name": "compile",
          "argv": [
            "bash",
            "Release/stado-release.sh",
            "compile"
          ],
          "kind": "lint"
        }
      ],
      "build": {
        "argv": [
          "bash",
          "Release/stado-release.sh",
          "build"
        ]
      },
      "stage": {
        "release/Tama.app": "Tama.app",
        "release/Tama.zip": "Tama.zip",
        "release/Tama.zip.sparkle-signature": "Tama.zip.sparkle-signature",
        "release/appcast.xml": "appcast.xml",
        "evidence/release.json": "evidence/release.json",
        "evidence/notary.json": "evidence/notary.json",
        "evidence/DIGESTS": "evidence/DIGESTS"
      },
      "secret_env": {
        "MACOS_CERT_P12": "macos-developer-id#certificate_p12_base64",
        "MACOS_CERT_PASSWORD": "macos-developer-id#certificate_password",
        "MACOS_SIGN_IDENTITY": "macos-developer-id#sign_identity",
        "AC_API_KEY_ID": "apple-notary#key_id",
        "AC_API_ISSUER_ID": "apple-notary#issuer_id",
        "AC_API_KEY_P8": "apple-notary#private_key_p8_base64",
        "SPARKLE_PRIVATE_KEY": "tama-desktop-sparkle#private_key",
        "SPARKLE_PUBLIC_KEY": "tama-desktop-sparkle#public_key",
        "TAMA_APP_PROFILE_B64": "tama-desktop-provisioning#app_provisioning_profile_base64",
        "TAMA_NETWORK_FILTER_PROFILE_B64": "tama-desktop-provisioning#network_filter_provisioning_profile_base64"
      }
    }
  },
  "inputs": {
    "swiftpm-cache": {
      "uri": "stado://sources/tama-desktop/dependencies/swiftpm-cache/sha256/bc57786e80f67fa7008a94fbc4bfc51b3fe0d3c25d84d1a1d12f7d5b54973c31/source.tar.gz",
      "sha256": "bc57786e80f67fa7008a94fbc4bfc51b3fe0d3c25d84d1a1d12f7d5b54973c31",
      "mount": "swiftpm-cache.tar.gz",
      "extract": false
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  }
}
