#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -z "${TAMA_HOOK_RELEASE_ROOT:-}" ]; then
    if [ -d "$SCRIPT_DIR/hooks-release" ]; then
        TAMA_HOOK_RELEASE_ROOT="$SCRIPT_DIR/hooks-release"
    else
        TAMA_HOOK_RELEASE_ROOT="$SCRIPT_DIR/../.build/Tama.app/Contents/Resources/hooks-release"
    fi
fi
TAMA_HOOK_INSTALLER=${TAMA_HOOK_INSTALLER:-"$SCRIPT_DIR/install_hook_release.py"}
export TAMA_HOOK_RELEASE_ROOT TAMA_HOOK_INSTALLER

ACTION=${TAMA_EMERGENCY_ACTION:-disable}
case "$ACTION" in
    disable|enable) ;;
    *) printf '%s\n' "Unsupported Tama emergency action: $ACTION" >&2; exit 2 ;;
esac
export TAMA_EMERGENCY_ACTION="$ACTION"
export TAMA_SKIP_SESSION_RESTART=${TAMA_SKIP_SESSION_RESTART:-0}
TAMA_SESSION_SUPERVISOR=${TAMA_SESSION_SUPERVISOR:-"$TAMA_HOOK_RELEASE_ROOT/shared-hooks/agent-session-supervisor.py"}
TAMA_SUPERVISOR_HOME=${TAMA_HOME:-"$HOME"}
export TAMA_SESSION_SUPERVISOR TAMA_SUPERVISOR_HOME

supervisor_paused=0
resume_supervised_sessions() {
    if [ "$supervisor_paused" = 1 ]; then
        python3 "$TAMA_SESSION_SUPERVISOR" control resume \
            --home "$TAMA_SUPERVISOR_HOME" >/dev/null \
            || printf '%s\n' "Tama could not resume one or more supervised agent sessions." >&2
    fi
}

if [ "$TAMA_SKIP_SESSION_RESTART" != 1 ]; then
    [ -f "$TAMA_SESSION_SUPERVISOR" ] || {
        printf 'Tama session supervisor is missing: %s\n' "$TAMA_SESSION_SUPERVISOR" >&2
        exit 66
    }
    supervisor_paused=1
    trap resume_supervised_sessions EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    python3 "$TAMA_SESSION_SUPERVISOR" control pause \
        --home "$TAMA_SUPERVISOR_HOME" \
        --require-all >/dev/null
fi

python3 - <<'PY'
from pathlib import Path
from datetime import datetime, timezone
import json
import os
import shutil
import subprocess
import signal
import sys

action = os.environ["TAMA_EMERGENCY_ACTION"]

home = Path(os.environ.get("TAMA_HOME") or Path.home())
tama = home / "Library/Application Support/Tama"
backup = tama / "emergency-backup"
backup.mkdir(parents=True, exist_ok=True)




def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tama-tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    os.replace(temporary, path)




def disable_config(label, path, manifest):
    if not path.exists():
        return
    destination = backup / label
    if not destination.exists():
        shutil.copy2(path, destination)
    value = json.loads(path.read_text())
    commands = [
        hook.get("command", "")
        for groups in value.get("hooks", {}).values()
        for group in groups
        for hook in group.get("hooks", [])
        if isinstance(hook, dict)
    ]
    if not commands or any("run-hook.mjs" not in command for command in commands):
        value["hooks"] = {}
        atomic_json(path, value)
    manifest["configs"].append(str(path))


def disable_entrypoint(path, manifest):
    destination = path.with_name(path.name + ".tama-disabled")
    if destination.exists():
        if path.exists():
            raise SystemExit(
                f"Both active and disabled hook entrypoints exist: {path}"
            )
        manifest["moved"].append(
            {"source": str(path), "disabled": str(destination)}
        )
        return
    if not path.exists():
        return
    os.replace(path, destination)
    manifest["moved"].append({"source": str(path), "disabled": str(destination)})






manifest_path = backup / "manifest.json"
if action == "enable":
    if not manifest_path.exists():
        raise SystemExit("Tama has no emergency backup manifest to restore.")
    json.loads(manifest_path.read_text())
elif manifest_path.exists():
    print("Tama hooks are already disabled.")
    raise SystemExit(0)
else:
    (backup / "claude-settings.json").unlink(missing_ok=True)
    (backup / "codex-hooks.json").unlink(missing_ok=True)

manifest = {
    "configs": [],
    "moved": [],
    "editorWatcherStopped": False,
}

if action == "disable":
    installer = Path(os.environ["TAMA_HOOK_INSTALLER"])
    release_root = Path(os.environ["TAMA_HOOK_RELEASE_ROOT"])
    install = subprocess.run(
        [
            sys.executable,
            str(installer),
            "--release",
            str(release_root),
            "--home",
            str(home),
            "--session-control-only",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if install.returncode != 0:
        raise SystemExit(
            install.stderr.strip()
            or install.stdout.strip()
            or "Tama could not install provider session controllers."
        )
    disable_config("claude-settings.json", home / ".claude/settings.json", manifest)
    disable_config("codex-hooks.json", home / ".codex/hooks.json", manifest)
    disable_entrypoint(home / ".omp/agent/hooks", manifest)

    registry_path = home / ".shared-hooks/registry.json"
    if registry_path.exists():
        registry = json.loads(registry_path.read_text())
        for hook in registry.get("catalog", {}).get("gitHooks", []):
            source = hook.get("source")
            if source:
                disable_entrypoint(Path(source).expanduser(), manifest)

    pid_path = home / ".shared-hooks/editor-hooks.pid"
    if pid_path.exists():
        try:
            os.kill(int(pid_path.read_text().strip()), signal.SIGTERM)
            manifest["editorWatcherStopped"] = True
        except (OSError, ValueError):
            pass
        pid_path.unlink(missing_ok=True)

    launch_agent = home / "Library/LaunchAgents/com.wisent.editor-hooks.plist"
    if launch_agent.exists():
        subprocess.run(
            ["launchctl", "bootout", f"gui/{os.getuid()}", str(launch_agent)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        disable_entrypoint(launch_agent, manifest)
else:
    installer = Path(os.environ["TAMA_HOOK_INSTALLER"])
    release_root = Path(os.environ["TAMA_HOOK_RELEASE_ROOT"])
    if not installer.is_file():
        raise SystemExit(f"Tama hook release installer is missing: {installer}")
    if not (release_root / "release.json").is_file():
        raise SystemExit(f"Tama approved hook release is missing: {release_root}")
    install = subprocess.run(
        [
            sys.executable,
            str(installer),
            "--release",
            str(release_root),
            "--home",
            str(home),
            "--emergency-manifest",
            str(manifest_path),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if install.returncode != 0:
        raise SystemExit(
            install.stderr.strip()
            or install.stdout.strip()
            or "Tama could not install the approved hook release."
        )
    installed_release = json.loads(install.stdout)["installed"]

    launch_agent = home / "Library/LaunchAgents/com.wisent.editor-hooks.plist"
    if launch_agent.exists():
        subprocess.run(
            ["launchctl", "bootstrap", f"gui/{os.getuid()}", str(launch_agent)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )

state_path = tama / "hook-emergency-state.json"
if action == "disable":
    atomic_json(manifest_path, manifest)
    atomic_json(
        state_path,
        {
            "schema": "ai.wisent.tama.hook-emergency-state.v1",
            "disabled": True,
            "changedAt": datetime.now(timezone.utc).isoformat(),
        },
    )
    print("Disabled hooks. Supervised agent sessions will resume without an editor restart.")
else:
    state_path.unlink(missing_ok=True)
    manifest_path.unlink(missing_ok=True)
    (backup / "claude-settings.json").unlink(missing_ok=True)
    (backup / "codex-hooks.json").unlink(missing_ok=True)
    print(
        f"Enabled approved hook release {installed_release['releaseId'][:12]}. "
        "Supervised agent sessions will resume without an editor restart."
    )

shutil.rmtree(tama / "vscode-resume", ignore_errors=True)
shutil.rmtree(
    home / ".vscode/extensions/tama.emergency-resume-1.0.0",
    ignore_errors=True,
)
PY
if [ "$supervisor_paused" = 1 ]; then
    python3 "$TAMA_SESSION_SUPERVISOR" control resume \
        --home "$TAMA_SUPERVISOR_HOME" >/dev/null
    supervisor_paused=0
    trap - EXIT HUP INT TERM
fi
