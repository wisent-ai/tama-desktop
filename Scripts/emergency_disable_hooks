#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -z "${TAMA_HOOK_RELEASE_ROOT:-}" ]; then
    if [ -d "$SCRIPT_DIR/hooks-release" ]; then
        TAMA_HOOK_RELEASE_ROOT="$SCRIPT_DIR/hooks-release"
    else
        TAMA_HOOK_RELEASE_ROOT="$SCRIPT_DIR/../.build/Tama.app/Contents/Resources/hooks-release"
    fi
fi
# The approved release's own tama is its installer (`tama hooks install-release`).
TAMA_HOOK_INSTALLER=${TAMA_HOOK_INSTALLER:-"$TAMA_HOOK_RELEASE_ROOT/bin/tama"}
export TAMA_HOOK_RELEASE_ROOT TAMA_HOOK_INSTALLER
# The expiry agent (`emergency_expiry_agent`, bundled beside this file) runs
# this same file again, by its absolute path, and lifts the switch at its end.
TAMA_EMERGENCY_SCRIPT="$SCRIPT_DIR/$(basename -- "$0")"
EXPIRY_AGENT="$SCRIPT_DIR/emergency_expiry_agent"
export TAMA_EMERGENCY_SCRIPT EXPIRY_AGENT

ACTION=${TAMA_EMERGENCY_ACTION:-disable}
case "$ACTION" in
    disable|enable) ;;
    *) printf '%s\n' "Unsupported Tama emergency action: $ACTION" >&2; exit 2 ;;
esac
export TAMA_EMERGENCY_ACTION="$ACTION"
# A disable names who throws the switch, why, and how many minutes it holds:
# a switch nobody can attribute or that never ends is how every guard stayed
# off unseen. The hooks read `expiresAt` and run again once it has passed.
if [ "$ACTION" = disable ]; then
    for required in TAMA_EMERGENCY_SET_BY TAMA_EMERGENCY_REASON TAMA_EMERGENCY_MINUTES; do
        eval "value=\${$required:-}"
        if [ -z "$value" ]; then
            printf '%s\n' "Tama will not disable its hooks without $required: the switch records who set it (TAMA_EMERGENCY_SET_BY), why (TAMA_EMERGENCY_REASON) and for how many minutes it holds (TAMA_EMERGENCY_MINUTES), after which the hooks run again." >&2
            exit 2
        fi
    done
    case "$TAMA_EMERGENCY_MINUTES" in
        ''|*[!0-9]*|0) printf '%s\n' "TAMA_EMERGENCY_MINUTES is $TAMA_EMERGENCY_MINUTES; it must be a whole number of minutes above zero." >&2; exit 2 ;;
    esac
fi
if [ "$ACTION" = enable ] && [ "${TAMA_EMERGENCY_TRIGGER:-}" = expiry ]; then
    # The agent's own run: before the end, or with nothing to lift, it is done.
    status=0
    python3 "$EXPIRY_AGENT" due || status=$?
    [ "$status" -eq 0 ] || exit 0
fi

python3 - <<'PY'
from pathlib import Path
from datetime import datetime, timedelta, timezone
import json
import os
import shutil
import subprocess
import signal
import sys

action = os.environ["TAMA_EMERGENCY_ACTION"]

home = Path(os.environ.get("TAMA_HOME") or Path.home())
tama = home / "Library/Application Support/Tama"
backup = tama / "emergency-backup"
backup.mkdir(parents=True, exist_ok=True)
state_path = tama / "hook-emergency-state.json"




def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tama-tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    os.replace(temporary, path)




def disable_config(label, path, manifest):
    if not path.exists():
        return
    destination = backup / label
    if not destination.exists():
        shutil.copy2(path, destination)
    value = json.loads(path.read_text())
    commands = [
        hook.get("command", "")
        for groups in value.get("hooks", {}).values()
        for group in groups
        for hook in group.get("hooks", [])
        if isinstance(hook, dict)
    ]
    if not commands or any("run-hook.mjs" not in command for command in commands):
        value["hooks"] = {}
        atomic_json(path, value)
    manifest["configs"].append(str(path))


def disable_entrypoint(path, manifest):
    destination = path.with_name(path.name + ".tama-disabled")
    if destination.exists():
        if path.exists():
            raise SystemExit(
                f"Both active and disabled hook entrypoints exist: {path}"
            )
        manifest["moved"].append(
            {"source": str(path), "disabled": str(destination)}
        )
        return
    if not path.exists():
        return
    os.replace(path, destination)
    manifest["moved"].append({"source": str(path), "disabled": str(destination)})






manifest_path = backup / "manifest.json"
if action == "enable":
    if not manifest_path.exists():
        # A switch written without this script set nothing aside, so there is
        # nothing to restore: lifting it is removing it. Without a switch
        # either, there is nothing to lift.
        if not state_path.exists():
            raise SystemExit(
                "Tama has no emergency switch set and no emergency backup manifest to restore."
            )
        state_path.unlink()
        print(
            "Lifted an emergency switch that set nothing aside (no emergency-backup/manifest.json): "
            "every hook runs again. Running agent sessions read the cleared emergency state at once "
            "and keep running."
        )
        raise SystemExit(0)
    json.loads(manifest_path.read_text())
elif manifest_path.exists():
    print("Tama hooks are already disabled.")
    raise SystemExit(0)
else:
    (backup / "claude-settings.json").unlink(missing_ok=True)
    (backup / "codex-hooks.json").unlink(missing_ok=True)

manifest = {
    "configs": [],
    "moved": [],
    "editorWatcherStopped": False,
}

if action == "disable":
    installer = Path(os.environ["TAMA_HOOK_INSTALLER"])
    release_root = Path(os.environ["TAMA_HOOK_RELEASE_ROOT"])
    install = subprocess.run(
        [
            str(installer),
            "hooks",
            "install-release",
            "--release",
            str(release_root),
            "--home",
            str(home),
            "--session-control-only",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if install.returncode != 0:
        raise SystemExit(
            install.stderr.strip()
            or install.stdout.strip()
            or "Tama could not install provider session controllers."
        )
    disable_config("claude-settings.json", home / ".claude/settings.json", manifest)
    disable_config("codex-hooks.json", home / ".codex/hooks.json", manifest)
    disable_entrypoint(home / ".omp/agent/hooks", manifest)

    registry_path = home / ".shared-hooks/registry.json"
    if registry_path.exists():
        registry = json.loads(registry_path.read_text())
        for hook in registry.get("catalog", {}).get("gitHooks", []):
            source = hook.get("source")
            if source:
                disable_entrypoint(Path(source).expanduser(), manifest)

    pid_path = home / ".shared-hooks/editor-hooks.pid"
    if pid_path.exists():
        try:
            os.kill(int(pid_path.read_text().strip()), signal.SIGTERM)
            manifest["editorWatcherStopped"] = True
        except (OSError, ValueError):
            pass
        pid_path.unlink(missing_ok=True)

    launch_agent = home / "Library/LaunchAgents/com.wisent.editor-hooks.plist"
    if launch_agent.exists():
        subprocess.run(
            ["launchctl", "bootout", f"gui/{os.getuid()}", str(launch_agent)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        disable_entrypoint(launch_agent, manifest)
else:
    installer = Path(os.environ["TAMA_HOOK_INSTALLER"])
    release_root = Path(os.environ["TAMA_HOOK_RELEASE_ROOT"])
    if not installer.is_file():
        raise SystemExit(f"Tama hook release installer is missing: {installer}")
    if not (release_root / "release.json").is_file():
        raise SystemExit(f"Tama approved hook release is missing: {release_root}")
    install = subprocess.run(
        [
            str(installer),
            "hooks",
            "install-release",
            "--release",
            str(release_root),
            "--home",
            str(home),
            "--emergency-manifest",
            str(manifest_path),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if install.returncode != 0:
        raise SystemExit(
            install.stderr.strip()
            or install.stdout.strip()
            or "Tama could not install the approved hook release."
        )
    installed_release = json.loads(install.stdout)["installed"]

    launch_agent = home / "Library/LaunchAgents/com.wisent.editor-hooks.plist"
    if launch_agent.exists():
        subprocess.run(
            ["launchctl", "bootstrap", f"gui/{os.getuid()}", str(launch_agent)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )

if action == "disable":
    atomic_json(manifest_path, manifest)
    now = datetime.now(timezone.utc)
    minutes = int(os.environ["TAMA_EMERGENCY_MINUTES"])
    atomic_json(
        state_path,
        {
            "schema": "ai.wisent.tama.hook-emergency-state.v1",
            "disabled": True,
            "setBy": os.environ["TAMA_EMERGENCY_SET_BY"],
            "reason": os.environ["TAMA_EMERGENCY_REASON"],
            "changedAt": now.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
            "expiresAt": (now + timedelta(minutes=minutes)).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
        },
    )
    print(
        f"Disabled hooks for {minutes} minutes. Running agent sessions read the emergency "
        "state at once and keep running; the hooks run again when it expires."
    )
else:
    state_path.unlink(missing_ok=True)
    manifest_path.unlink(missing_ok=True)
    (backup / "claude-settings.json").unlink(missing_ok=True)
    (backup / "codex-hooks.json").unlink(missing_ok=True)
    print(
        f"Enabled approved hook release {installed_release['releaseId'][:12]}. "
        "Running agent sessions read the cleared emergency state at once and keep running."
    )


shutil.rmtree(tama / "vscode-resume", ignore_errors=True)
shutil.rmtree(
    home / ".vscode/extensions/tama.emergency-resume-1.0.0",
    ignore_errors=True,
)
PY
# A disable schedules the switch's own lifting; an enable, by hand or by the
# agent itself, takes the agent away once the switch is gone.
if [ "$ACTION" = disable ]; then
    python3 "$EXPIRY_AGENT" install
elif [ ! -e "${TAMA_HOME:-$HOME}/Library/Application Support/Tama/hook-emergency-state.json" ]; then
    python3 "$EXPIRY_AGENT" remove
fi
