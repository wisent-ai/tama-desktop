#!/usr/bin/env python3
"""The emergency switch's own lifting, bundled beside emergency_disable_hooks.

Every reader already treats a switch past its `expiresAt` as lifted. This
agent also runs the full re-enable at that time, so the entrypoints the
disable set aside come back without anyone pressing a button.

  emergency_expiry_agent install   schedule the agent (after a disable)
  emergency_expiry_agent remove    take it away (after an enable)
  emergency_expiry_agent due       exit 0 once the switch has expired, 3 before
                                   then; with no switch, or one that names no
                                   end, remove the agent and exit 4

`install` writes a LaunchAgent that runs emergency_disable_hooks as an enable
every minute and at login, with `TAMA_EMERGENCY_TRIGGER=expiry`, so the script
asks `due` first. One agent per home (`TAMA_HOME`), so a run on another home
never replaces the account's own. What each run printed lands in
`emergency-expiry.log` beside the switch.
"""
from datetime import datetime, timezone
from pathlib import Path
import hashlib
import json
import os
import plistlib
import subprocess
import sys

DUE, NOT_YET, NOTHING_TO_LIFT = 0, 3, 4

home = Path(os.environ.get("TAMA_HOME") or Path.home())
tama = home / "Library/Application Support/Tama"
state_path = tama / "hook-emergency-state.json"
label = "ai.wisent.tama.emergency-expiry." + hashlib.sha256(str(home).encode()).hexdigest()[:12]
agent = home / f"Library/LaunchAgents/{label}.plist"
domain = f"gui/{os.getuid()}"


def install():
    agent.parent.mkdir(parents=True, exist_ok=True)
    environment = {"TAMA_EMERGENCY_ACTION": "enable", "TAMA_EMERGENCY_TRIGGER": "expiry", "TAMA_HOME": str(home)}
    for name in ("TAMA_HOOK_RELEASE_ROOT", "TAMA_HOOK_INSTALLER", "PATH"):
        environment[name] = os.environ[name]
    with open(agent, "wb") as handle:
        plistlib.dump({
            "Label": label,
            "ProgramArguments": ["/bin/sh", os.environ["TAMA_EMERGENCY_SCRIPT"]],
            "EnvironmentVariables": environment,
            "StartInterval": 60,
            "RunAtLoad": True,
            "StandardOutPath": str(tama / "emergency-expiry.log"),
            "StandardErrorPath": str(tama / "emergency-expiry.log"),
        }, handle)
    loaded = subprocess.run(["launchctl", "bootstrap", domain, str(agent)], capture_output=True, text=True, check=False)
    if loaded.returncode != 0:
        print(
            f"Tama could not schedule the switch's own lifting (launchctl bootstrap {agent} exited "
            f"{loaded.returncode}: {loaded.stderr.strip()}); every reader still treats it as lifted at its "
            "expiry, and Re-enable all policies restores what it set aside.",
            file=sys.stderr,
        )
    return 0


def remove():
    # Booting out the agent ends the run it started, so it comes last.
    if agent.exists():
        agent.unlink()
        subprocess.run(["launchctl", "bootout", f"{domain}/{label}"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return 0


def due():
    switch = json.loads(state_path.read_text()) if state_path.exists() else {}
    ends = switch.get("expiresAt") if switch.get("disabled") is True else None
    if not isinstance(ends, str):
        # Lifted by hand, or a switch that names no end: nothing to wait for.
        remove()
        return NOTHING_TO_LIFT
    if datetime.now(timezone.utc) < datetime.fromisoformat(ends.replace("Z", "+00:00")):
        return NOT_YET
    print(f"The emergency switch expired at {ends}; restoring every hook.")
    return DUE


verbs = {"install": install, "remove": remove, "due": due}
if len(sys.argv) != 2 or sys.argv[1] not in verbs:
    print(f"Usage: emergency_expiry_agent {'|'.join(verbs)}; got {sys.argv[1:]}", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(verbs[sys.argv[1]]())
