{
  "$schema": "https://github.com/wisent-ai/wisent-desktop-update/raw/main/release-manifest.schema.json",
  "schema": 1,
  "product": "Tama",
  "bundle_id": "ai.wisent.tama.desktop",
  "bundle_path": ".build/Tama.app",
  "build_command": "TAMA_HOOK_ROOT=\"$GITHUB_WORKSPACE/.release-source\" TAMA_BUILD_CHANNEL=stable TAMA_CODESIGN_TIMESTAMP=--timestamp TAMA_INSTALL_AFTER_BUILD=no ./Scripts/build-app.sh",
  "archive_name": "Tama-{version}.zip",
  "feed_url": "https://github.com/wisent-ai/tama-desktop/releases/latest/download/appcast.xml",
  "minimum_system_version": "14.0",
  "backend": {
    "repository": "wisent-ai/tama",
    "revision_file": "Release/tama-revision",
    "checkout_path": ".release-source"
  }
}
